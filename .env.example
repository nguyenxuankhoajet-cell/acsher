# Đổi thành mật khẩu mạnh của riêng bạn trước khi deploy
ADMIN_PASSWORD=doi_mat_khau_nay_truoc_khi_dung
# Chuỗi bí mật để ký token đăng nhập admin - đổi thành chuỗi ngẫu nhiên dài
JWT_SECRET=doi_chuoi_bi_mat_nay_thanh_ngau_nhien_dai_hon
# Cổng server (Render/Railway sẽ tự set PORT, để mặc định là được)
PORT=3000

# Dùng để gửi email OTP xác thực khi khách đăng ký tài khoản
# GMAIL_USER là địa chỉ Gmail của bạn, GMAIL_APP_PASSWORD là "Mật khẩu ứng dụng"
# lấy tại https://myaccount.google.com/apppasswords (KHÔNG phải mật khẩu Gmail thường)
GMAIL_USER=diachi_cua_ban@gmail.com
GMAIL_APP_PASSWORD=dan_chuoi_16_ky_tu_vao_day

# Chuỗi kết nối database Supabase - lấy tại Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:mat_khau_cua_ban@db.xxxxx.supabase.co:5432/postgres
